{
  "version": "1.0.0",
  "tenancy": {
    "strategy": "DISCRIMINATOR_COLUMN",
    "discriminator_field": "tenant_id",
    "isolation_validation_query": "SELECT count(*) FROM pg_tables WHERE schemaname = 'public'"
  },
  "environments": {
    "dev": {
      "cors_allowed_origins": ["http://localhost:3000", "http://localhost:5173"],
      "auth_issuer_url": "https://api.workos.com/",
      "deployment_manifest": "docker-compose.yml",
      "database": {
        "engine": "postgresql",
        "major_version": "16",
        "name": "gh_clearing"
      }
    },
    "staging": {
      "cors_allowed_origins": ["https://staging.groundhandling.net"],
      "auth_issuer_url": "https://api.workos.com/",
      "deployment_manifest": "backend/src/main/resources/deploy/render.yaml",
      "spring_profile": "staging",
      "network_isolation": true,
      "database": {
        "engine": "postgresql",
        "major_version": "16",
        "name": "gh-clearing-staging-db"
      }
    },
    "production": {
      "cors_allowed_origins": ["https://app.groundhandling.net"],
      "auth_issuer_url": "https://api.workos.com/",
      "deployment_manifest": null,
      "status": "NOT_CONFIGURED"
    }
  },
  "network_policies": {
    "sandboxed_runners": {
      "internet_access": "BLOCKED",
      "allowed_internal_ips": ["10.0.0.1/32"]
    }
  }
}
