{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pull Request Review Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pr",
    "reviewer",
    "status",
    "timestamp",
    "proof_verified",
    "hash"
  ],
  "properties": {
    "pr": {
      "type": "integer",
      "minimum": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "APPROVED"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "proof_verified": {
      "enum": ["UNIT", "INTEGRATION", "CONFORMANCE", "COMPILER", "E2E"]
    },
    "hash": {
      "type": "string",
      "description": "Cryptographic hash of the verification proof or signed approval artifact.",
      "pattern": "^[0-9a-fA-F]{40,64}$"
    }
  }
}
