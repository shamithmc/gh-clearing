<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:ghcm:credit-note:1.0"
           xmlns:tns="urn:ghcm:credit-note:1.0"
           elementFormDefault="qualified">
    <xs:element name="CreditNote">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="CreditNoteNumber" type="xs:string"/>
                <xs:element name="OriginalInvoiceNumber" type="xs:string"/>
                <xs:element name="DisputeNumber" type="xs:string"/>
                <xs:element name="IssueDate" type="xs:date"/>
                <xs:element name="SupplierId" type="xs:string"/>
                <xs:element name="AirlineId" type="xs:string"/>
                <xs:element name="AirportCode" type="xs:string"/>
                <xs:element name="Currency">
                    <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[A-Z]{3}"/></xs:restriction></xs:simpleType>
                </xs:element>
                <xs:element name="Amount" type="tns:positiveDecimal"/>
                <xs:element name="Reason" type="xs:string"/>
            </xs:sequence>
            <xs:attribute name="version" type="xs:string" fixed="1.0"/>
        </xs:complexType>
    </xs:element>

    <xs:simpleType name="positiveDecimal">
        <xs:restriction base="xs:decimal"><xs:minExclusive value="0"/></xs:restriction>
    </xs:simpleType>
</xs:schema>
